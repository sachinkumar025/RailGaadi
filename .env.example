# RailGaadi Environment Variables Template

# RailRadar API Key (Required for live train tracking & search)
RAILRADAR_API_KEY=

# MapTiler API Key (Required for vector map tiles)
MAPTILER_API_KEY=
NEXT_PUBLIC_MAPTILER_API_KEY=

# OpenWeather API Key (Required for live weather companion)
OPENWEATHER_API_KEY=

# OpenTopography API Key (Required for route elevation profiles)
OPENTOPOGRAPHY_API_KEY=

# Upstash Redis (Optional - for caching)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

